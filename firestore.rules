rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Supports both legacy { role: 'admin' } and new { roles: ['admin', ...] }
    function hasRole(r) {
      let d = getUserData();
      return isSignedIn() && (
        (d.keys().hasAny(['roles']) && d.roles.hasAny([r])) ||
        (d.keys().hasAny(['role']) && d.role == r)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSupervisor() {
      return hasRole('supervisor') || isAdmin();
    }

    function isProviderFor(providerName) {
      let d = getUserData();
      return isSignedIn() && d.providerName == providerName && (
        (d.keys().hasAny(['roles']) && d.roles.hasAny(['provider', 'intern', 'supervisor'])) ||
        (d.keys().hasAny(['role']) && d.role == 'provider')
      );
    }

    function emailIsInAdminList() {
      return get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]);
    }

    // ── Inquiries — admin only ────────────────────────────────────────────────
    match /inquiries/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Providers — any signed-in user can read; write = admin or own row ────
    match /providers/{providerName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isProviderFor(providerName);
    }

    // ── Personnel sub-collections (credentials, ceus, trainings, contracts) ──
    // Admin has full access; providers can read their own records
    match /providers/{providerName}/{subcollection}/{docId} {
      allow read: if isAdmin() || isProviderFor(providerName);
      allow write: if isAdmin();
    }

    // ── Requirements — admin manages templates; all signed-in users can read ──
    match /requirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Requirement completions — admin write; provider can read own ──────────
    match /requirements/{reqId}/completions/{providerName} {
      allow read: if isAdmin() || isProviderFor(providerName);
      allow write: if isAdmin();
    }

    // ── Intern profiles — admin write; intern or supervisor read ─────────────
    match /internProfiles/{providerName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Hour entries ─────────────────────────────────────────────────────────
    // - Intern: read/create own; edit + delete own until it is signed off
    // - Supervisor: same for assigned interns, plus sign-off / reopen
    // - Admin: full access
    match /hourEntries/{entryId} {

      function isOwnerOf(internName) {
        return isSignedIn() && getUserData().providerName == internName;
      }

      function isSupervisorOf(internName) {
        return hasRole('supervisor') &&
          get(/databases/$(database)/documents/internProfiles/$(internName)).data.supervisorName == getUserData().providerName;
      }

      // A signed-off entry is locked — nobody but a supervisor/admin may touch it.
      function isSignedOff() {
        return resource.data.get('approvedAt', null) != null;
      }

      // True when the incoming write carries a sign-off stamp.
      function claimsSignOff() {
        return request.resource.data.get('approvedAt', null) != null;
      }

      // The only fields an intern may change on their own entry.
      function onlyEditsOwnFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['date', 'type', 'hours', 'notes', 'updatedAt']);
      }

      allow read: if isAdmin() ||
        isOwnerOf(resource.data.internName) ||
        isSupervisorOf(resource.data.internName);

      // Interns may never create a pre-approved entry — only a supervisor can sign off.
      allow create: if isAdmin() ||
        isSupervisorOf(request.resource.data.internName) ||
        (isOwnerOf(request.resource.data.internName) && !claimsSignOff());

      // Supervisor/admin: full edit, plus sign-off and reopen.
      allow update: if (isAdmin() || isSupervisorOf(resource.data.internName)) &&
        request.resource.data.internName == resource.data.internName;

      // Intern: may correct their own entry until it's signed off, and may never self-sign-off.
      allow update: if isOwnerOf(resource.data.internName) &&
        !isSignedOff() &&
        !claimsSignOff() &&
        onlyEditsOwnFields();

      allow delete: if isAdmin() ||
        isSupervisorOf(resource.data.internName) ||
        (isOwnerOf(resource.data.internName) && !isSignedOff());
    }

    // ── Change requests — intern creates own; admin/supervisor manage ────────
    match /changeRequests/{reqId} {
      allow read: if isAdmin() || isSupervisor() ||
        (isSignedIn() && getUserData().providerName == resource.data.internName);
      allow create: if isSignedIn() &&
        getUserData().providerName == request.resource.data.internName;
      allow update, delete: if isAdmin() || isSupervisor();
    }

    // ── Recurring tasks ──────────────────────────────────────────────────────
    // - Any signed-in staff can read (they need to see their assignments)
    // - Admin/supervisor create, edit, delete task definitions
    // - Completions: a person marks their OWN task done; admin/supervisor any
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSupervisor();

      match /completions/{providerName} {
        allow read: if isSignedIn();
        allow write: if isSupervisor() ||
          (isSignedIn() && getUserData().providerName == providerName);
      }
    }

    // ── Users — own read/create; admin full access ────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.roles.hasAny(['provider', 'intern', 'supervisor'])
          || (request.resource.data.roles.hasAny(['admin']) && emailIsInAdminList())
          // legacy single-role support during transition
          || request.resource.data.role == 'provider'
          || (request.resource.data.role == 'admin' && emailIsInAdminList())
        );
      allow update, delete: if isAdmin();
    }

    // ── Intranet posts — any signed-in user can read/post/react/comment ─────────
    match /intranet_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // update: reactions, commentCount (any user), pinned (admin only)
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ── Config — signed-in read; no client writes ─────────────────────────────
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Intranet config — signed-in read; admin write ─────────────────────────
    match /intranet_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Intranet resource links (shared folders, docs) — admin write ─────────
    match /intranet_resources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Intranet website links — admin write ─────────────────────────────────
    match /intranet_links/{linkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    // - Recipient: read/update (mark read) own
    // - Admin/supervisor: create
    // - Admin: delete
    match /notifications/{notifId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.recipientProviderName == getUserData().providerName);
      allow create: if isAdmin() || hasRole('supervisor');
      allow update: if isSignedIn() &&
        resource.data.recipientProviderName == getUserData().providerName;
      allow delete: if isAdmin();
    }
  }
}
