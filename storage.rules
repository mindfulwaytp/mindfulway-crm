rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ceu-proofs/{providerName}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /requirement-proofs/{providerName}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
